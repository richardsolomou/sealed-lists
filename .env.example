# Optional. Signs realtime tokens and is Centrifugo's API key. The container
# generates one into $DATA_DIR/realtime-secret; development uses a fixed one.
# REALTIME_SECRET=

# Optional PostHog project token, read at build time for the browser and at
# runtime for the server. When set, product analytics, session replay, feature
# flags, and browser/server error tracking are enabled through /t (`ingestPath`
# in src/contracts/posthog.ts), so ad-blocker rules targeting the well-known
# /ingest path don't catch it.
# VITE_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Source-map upload, only from CI (CI=true) or with POSTHOG_UPLOAD_SOURCEMAPS=true.
# POSTHOG_CLI_API_KEY=
# POSTHOG_CLI_PROJECT_ID=
# POSTHOG_CLI_HOST=https://us.posthog.com

# Public origin, e.g. https://sealed-lists.example.com. This restricts realtime
# connections, sets the canonical host, and is used for links in email.
APP_URL=

# Only behind a proxy that replaces X-Forwarded-Host and X-Forwarded-Proto, when
# APP_URL is unset.
# TRUST_PROXY=true

# Signs session cookies. Required in production; generate with:
# openssl rand -base64 32
# Changing it signs everyone out. Deployments that set AUTH_SECRET, or that rely
# on the $DATA_DIR/auth.secret earlier releases generated, keep using it while
# BETTER_AUTH_SECRET is unset; to move, copy that value here unchanged.
BETTER_AUTH_SECRET=

# Email. Without SMTP_HOST and EMAIL_FROM the app sends nothing: no address
# confirmation, no password reset, and no word when a game starts or reveals.
# Any provider that speaks SMTP works.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=sealed-lists@example.com

# Sign in with Google. Callback URL: https://your-host/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Discord. Callback URL: https://your-host/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
